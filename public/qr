<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />
  <title>QR Code Generator - Scrapbook</title>
  
  <link rel="icon" href="https://cdn.phototourl.com/free/2026-08-24-0e7c2cc9-5f6a-430b-a445-c9af7d03f431.jpg" type="image/jpeg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap"
    rel="stylesheet"
  />

  <!-- Library untuk Generate QR Code -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    body {
      font-family: "Inter", sans-serif;
    }
  </style>
</head>
<body class="bg-white text-black flex flex-col min-h-screen">
  <header
    class="flex items-center justify-between px-5 py-4 border-b border-neutral-200 sticky top-0 bg-white z-30"
  >
    <div class="flex items-center space-x-2">
      <img
        alt="Logo Scrapbook"
        class="w-12 h-12"
        height="48"
        src="https://cdn.phototourl.com/free/2026-08-24-0e7c2cc9-5f6a-430b-a445-c9af7d03f431.jpg"
        width="48"
      />
      <h1 class="font-extrabold text-3xl leading-none select-none tracking-tight text-black">
        Scrapbook
      </h1>
    </div>
  </header>

  <nav class="bg-neutral-100 border-b border-neutral-200">
    <ul
      class="flex justify-center space-x-12 py-4 font-semibold text-lg text-black"
    >
      <li><a href="index.html" class="hover:text-neutral-500 transition-colors duration-200">Home</a></li>
      <li><a href="about.html" class="hover:text-neutral-500 transition-colors duration-200">About</a></li>
      <li><a href="contact.html" class="hover:text-neutral-500 transition-colors duration-200">Contact</a></li>
    </ul>
  </nav>

  <main class="flex-grow px-5 py-10 max-w-2xl mx-auto w-full">
    <h2 class="font-extrabold text-4xl md:text-5xl leading-tight mb-4 text-black text-center">
      Pembuat QR Code
    </h2>
    <p class="text-center text-neutral-600 mb-8">
      Masukkan teks atau URL di bawah untuk membuat QR Code secara instan! 📱✨
    </p>

    <div class="bg-neutral-50 p-6 md:p-8 rounded-lg border border-neutral-200 shadow-sm">
      <div class="mb-6">
        <label for="qr-input" class="block text-black font-bold mb-2">Teks / Link URL</label>
        <input
          type="text"
          id="qr-input"
          placeholder="Contoh: https://scrapbook.biz.id atau teks biasa"
          class="w-full px-4 py-3 border border-neutral-300 rounded-md focus:outline-none focus:ring-2 focus:ring-black bg-white"
        />
      </div>

      <button
        id="generate-btn"
        class="w-full bg-black text-white font-bold py-3 px-4 rounded-md hover:bg-neutral-800 transition-colors duration-200 flex items-center justify-center space-x-2"
      >
        <i class="fas fa-qrcode"></i>
        <span>Buat QR Code</span>
      </button>

      <!-- Hasil QR Code -->
      <div id="qr-result" class="hidden mt-8 flex flex-col items-center border-t border-neutral-200 pt-6">
        <p class="font-semibold text-black mb-4">Hasil QR Code Kamu:</p>
        <div id="qrcode" class="p-4 bg-white border border-neutral-200 rounded-lg shadow-inner"></div>
        
        <button
          id="download-btn"
          class="mt-6 bg-neutral-200 text-black font-bold py-2 px-6 rounded-md hover:bg-neutral-300 transition-colors duration-200 flex items-center space-x-2"
        >
          <i class="fas fa-download"></i>
          <span>Unduh QR Code</span>
        </button>
      </div>
    </div>
  </main>

  <footer class="bg-black text-white py-10 px-5 mt-10">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-xl font-bold mb-4 text-white">Scrapbook</h3>
        <p class="text-sm text-neutral-300">
          Situs ini menyajikan berbagai artikel dan alat bermanfaat seputar kreasi scrapbook dan utilitas web.
        </p>
        <p class="mt-4 text-sm flex items-center text-neutral-300">
          <i class="fas fa-envelope mr-2"></i> adminsby@scrapbook.biz.id
        </p>
      </div>
      <div>
        <h3 class="text-xl font-bold mb-4 text-white">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="index.html" class="hover:text-neutral-400 transition-colors duration-200">Home</a></li>
          <li><a href="about.html" class="hover:text-neutral-400 transition-colors duration-200">About</a></li>
          <li><a href="contact.html" class="hover:text-neutral-400 transition-colors duration-200">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-neutral-800 mt-8 pt-8 text-center text-sm text-neutral-400">
      <p>Copyright © 2026 <a href="index.html" class="hover:text-white">Scrapbook</a></p>
    </div>
  </footer>

  <script>
    const qrInput = document.getElementById('qr-input');
    const generateBtn = document.getElementById('generate-btn');
    const qrResult = document.getElementById('qr-result');
    const qrcodeContainer = document.getElementById('qrcode');
    const downloadBtn = document.getElementById('download-btn');

    let qrcodeObj = null;

    generateBtn.addEventListener('click', () => {
      const text = qrInput.value.trim();
      if (!text) {
        alert('Mohon masukkan teks atau link terlebih dahulu!');
        return;
      }

      // Bersihkan QR Code sebelumnya
      qrcodeContainer.innerHTML = '';
      qrResult.classList.remove('hidden');

      // Generate QR Code baru
      qrcodeObj = new QRCode(qrcodeContainer, {
        text: text,
        width: 200,
        height: 200,
        colorDark: "#000000",
        colorLight: "#ffffff",
        correctLevel: QRCode.CorrectLevel.H
      });
    });

    // Fungsi untuk mengunduh QR Code
    downloadBtn.addEventListener('click', () => {
      const img = qrcodeContainer.querySelector('img');
      if (img && img.src) {
        const link = document.createElement('a');
        link.href = img.src;
        link.download = 'qrcode-scrapbook.png';
        link.click();
      } else {
        const canvas = qrcodeContainer.querySelector('canvas');
        if (canvas) {
          const link = document.createElement('a');
          link.href = canvas.toDataURL('image/png');
          link.download = 'qrcode-scrapbook.png';
          link.click();
        }
      }
    });
  </script>
</body>
</html>
